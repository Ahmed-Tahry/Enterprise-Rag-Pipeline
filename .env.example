# ── LLM Provider (choose one) ──────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Embedding Model ─────────────────────────────────────────
# Options: openai | huggingface
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_MODEL=text-embedding-3-small   # if using openai

# ── LLM Settings ────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
USE_HYBRID=true
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Vector Store ────────────────────────────────────────────
VECTOR_STORE_PATH=./data/vectorstore
VECTOR_STORE_TYPE=faiss

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Evaluation ──────────────────────────────────────────────
EVAL_LLM_MODEL=gpt-4o-mini
EVAL_SAMPLE_SIZE=50
