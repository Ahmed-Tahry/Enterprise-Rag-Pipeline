# ── LLM Provider ────────────────────────────────────────────
# Options: gemini (default), openai, anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash-lite
GOOGLE_API_KEY=YOUR_API_KEY_HERE
# OPENAI_API_KEY=sk-...       # if using openai provider
# ANTHROPIC_API_KEY=sk-ant-... # if using anthropic provider

# ── Embedding Model ─────────────────────────────────────────
# Options: huggingface (default, free), openai
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_MODEL=text-embedding-3-small   # if using openai

# ── LLM Settings ────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
USE_HYBRID=true
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Vector Store ────────────────────────────────────────────
VECTOR_STORE_PATH=./data/vectorstore
VECTOR_STORE_TYPE=faiss

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Evaluation ──────────────────────────────────────────────
EVAL_LLM_MODEL=gemini-2.0-flash-lite
EVAL_SAMPLE_SIZE=50
